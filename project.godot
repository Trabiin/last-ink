; Engine configuration file.
config_version=5

[application]

config/name="Last Ink"
config/description="Last Ink: action RPG prototype"
config/version="0.9.0"
config/icon="res://assets/icon/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="Last Ink"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Diag="*res://scripts/diag.gd"
Audio="*res://scripts/audio.gd"
Controls="*res://scripts/controls.gd"
Saves="*res://scripts/save.gd"
Empire="*res://scripts/empire.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)

[gui]

theme/custom_font="res://assets/fonts/body.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

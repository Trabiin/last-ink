extends SceneTree
## Writes locale/messages.pot: every player-facing string in scripts/ and data/, for translators
## (issue #143, docs/LOCALIZATION.md). Run tools/extract_strings.sh (or this script with Godot:
## godot --headless --path . -s tools/extract_strings.gd -- [out.pot]).
##
## The .pot is generated, not kept in git: it would go stale with every text edit. CI builds it
## for every change and keeps it as a download (the "messages-pot" artifact).

const Scan := preload("res://tools/loc_scan.gd")
const OUT := "res://locale/messages.pot"
## tr("x"), Loc.t("x"), tr("x", "ctx"), Loc.n("one", "many", ...), tr_n("one", "many", ...)
const CALL_RE := "(\\btr|Loc\\.t|TranslationServer\\.translate|tr_n|Loc\\.n|Loc\\.count)\\(\\s*(\"(?:[^\"\\\\]|\\\\.)*\")(?:\\s*,\\s*(\"(?:[^\"\\\\]|\\\\.)*\"))?"

var _frame := 0
var _entries := {}  # key (ctx + "\u0004" + msgid) -> {"id", "ctx", "plural", "refs": []}
var _order: Array = []


func _process(_delta: float) -> bool:
	_frame += 1
	if _frame == 2:  # autoloads (Controls' input actions) exist from the first frame on
		var args := OS.get_cmdline_user_args()
		var out: String = args[0] if args.size() > 0 else OUT
		var n := run(out)
		print("extract_strings: %d messages -> %s" % [n, out])
		quit(0)
	return false


func run(out_path: String) -> int:
	_entries.clear()
	_order.clear()
	_scripts()
	_data()
	var dir := out_path.get_base_dir()
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir) if dir.begins_with("res://") else dir)
	var f := FileAccess.open(out_path, FileAccess.WRITE)
	f.store_string(pot_text())
	return _order.size()


func add(msgid: String, ref: String, ctx := "", plural := "") -> void:
	if msgid.strip_edges() == "":
		return
	var key := ctx + "\u0004" + msgid
	if not _entries.has(key):
		_entries[key] = {"id": msgid, "ctx": ctx, "plural": plural, "refs": []}
		_order.append(key)
	if plural != "":
		_entries[key]["plural"] = plural
	if _entries[key]["refs"].size() < 6:
		_entries[key]["refs"].append(ref)


func _scripts() -> void:
	var scan := Scan.new()
	var call_re := RegEx.create_from_string(CALL_RE)
	var lit_re := RegEx.create_from_string("\"(?:[^\"\\\\]|\\\\.)*\"")
	var actions := InputMap.get_actions()
	for f in DirAccess.get_files_at("res://scripts/"):
		if not f.ends_with(".gd"):
			continue
		var path := "res://scripts/" + f
		var lines := FileAccess.get_file_as_string(path).split("\n")
		for n in lines.size():
			var line: String = lines[n]
			if line.strip_edges().begins_with("#"):
				continue
			for m in call_re.search_all(line):
				var id := _unq(m.get_string(2))
				var second := _unq(m.get_string(3)) if m.get_string(3) != "" else ""
				if m.get_string(1) in ["tr_n", "Loc.n", "Loc.count"]:
					add(id, "scripts/%s:%d" % [f, n + 1], "", second)
				else:
					add(id, "scripts/%s:%d" % [f, n + 1], second)
			# Prompts.help verbs: [action, "verb"] pairs, translated inside Prompts.help
			if "Prompts.help(" in line:
				for m in lit_re.search_all(line):
					var v := _unq(m.get_string())
					if v != "" and not StringName(v) in actions and not v in ["updown", "leftright", "move"]:
						add(v, "scripts/%s:%d" % [f, n + 1])
		for t in scan.script_texts(path):
			if t["const"]:
				add(t["text"], "scripts/%s:%d" % [f, t["line"]])


func _data() -> void:
	var scan := Scan.new()
	for f in DirAccess.get_files_at("res://data/"):
		if not f.ends_with(".json"):
			continue
		var parsed = JSON.parse_string(FileAccess.get_file_as_string("res://data/" + f))
		for s in scan.data_texts(f, parsed):
			add(s, "data/" + f)
		for k in Loc.KEYED_TEXT.get(f, []):
			for s in _values_of(parsed, k):
				add(s, "data/%s (%s)" % [f, k])


func _values_of(v, key: String) -> Array:
	var out := []
	match typeof(v):
		TYPE_DICTIONARY:
			for k in v:
				if str(k) == key and typeof(v[k]) == TYPE_STRING:
					out.append(v[k])
				else:
					out.append_array(_values_of(v[k], key))
		TYPE_ARRAY:
			for x in v:
				out.append_array(_values_of(x, key))
	return out


func pot_text() -> String:
	var s := "# Last Ink: player-facing text. Generated by tools/extract_strings.gd; do not edit by hand.\n"
	s += "# English text is the message id. Keep %s / %d / {tokens} exactly as they are; see docs/LOCALIZATION.md.\n"
	s += "msgid \"\"\nmsgstr \"\"\n\"Project-Id-Version: Last Ink %s\\n\"\n\"MIME-Version: 1.0\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Content-Transfer-Encoding: 8-bit\\n\"\n\n" % ProjectSettings.get_setting("application/config/version", "")
	for key in _order:
		var e: Dictionary = _entries[key]
		s += "#: " + " ".join(e["refs"]) + "\n"
		if "%" in e["id"]:
			s += "#, c-format\n"
		if e["ctx"] != "":
			s += "msgctxt " + _q(e["ctx"]) + "\n"
		s += "msgid " + _q(e["id"]) + "\n"
		if e["plural"] != "":
			s += "msgid_plural " + _q(e["plural"]) + "\nmsgstr[0] \"\"\nmsgstr[1] \"\"\n\n"
		else:
			s += "msgstr \"\"\n\n"
	return s


func _unq(lit: String) -> String:
	return lit.substr(1, lit.length() - 2).c_unescape()


func _q(s: String) -> String:
	return "\"" + s.c_escape().replace("\\'", "'") + "\""
